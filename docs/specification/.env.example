# ─────────────────────────────────────────────────────────────────────────────
# PolicyHub — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# .env.local is gitignored — NEVER commit it.
# This file (.env.example) IS committed — keep it up to date.
#
# Required to start: APP, Database, Valkey, and Session sections.
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────────────────────

# 32-byte base64 encryption key. Generate with: node ace generate:key
# Required. Changing this invalidates all existing sessions and encrypted data.
APP_KEY=

# Full base URL including scheme, no trailing slash.
APP_URL=http://localhost:3333

# One of: development, test, production
NODE_ENV=development

PORT=3333
HOST=0.0.0.0

# Pino log level: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info


# ── Database — PostgreSQL 16 ──────────────────────────────────────────────────
# Local defaults match docker-compose.yml.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=policyhub
DB_PASSWORD=policyhub
DB_DATABASE=policyhub

# Set true in production to require SSL connections.
DB_SSL=false


# ── Cache & Queues — Valkey ───────────────────────────────────────────────────
# Valkey is wire-compatible with Redis (ADR-004). Do not use Redis 7.4+ (AGPL).
# Local defaults match docker-compose.yml.

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# One of: redis, sync, memory.
# Use 'sync' in tests to run jobs inline. Set in .env.test — do not change here.
QUEUE_DRIVER=redis


# ── Session ───────────────────────────────────────────────────────────────────

# One of: cookie, redis
SESSION_DRIVER=cookie
SESSION_COOKIE_NAME=policyhub_session


# ── Authentication — Local (dev/staging ONLY) ─────────────────────────────────
# Enables POST /auth/local/login with email + password.
# MUST be false in production. See ADR-007 and story S1-08.
LOCAL_AUTH_ENABLED=false


# ── Authentication — OIDC / Microsoft Entra ───────────────────────────────────
# Required for SSO login. Leave blank when LOCAL_AUTH_ENABLED=true for local dev.
# See docs/PolicyHub_Entra_Setup.docx for step-by-step setup instructions.

# For Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
IDP_ISSUER_URL=

# Entra application (client) ID — Azure Portal → App registrations → Overview
IDP_CLIENT_ID=

# Entra client secret — App registrations → Certificates & secrets → Client secrets
IDP_CLIENT_SECRET=

# Must match the redirect URI registered in Entra exactly (scheme, host, path).
IDP_CALLBACK_URL=http://localhost:3333/auth/sso/callback

# ID token claim containing the user's group IDs. Entra default: groups
IDP_GROUPS_CLAIM=groups


# ── GitLab content repository ─────────────────────────────────────────────────
# Required for policy authoring and the approval workflow.
# See docs/PolicyHub_GitLab_Setup.docx for step-by-step setup.

# Base URL of your GitLab CE instance. No trailing slash.
GITLAB_BASE_URL=

# Service account PAT — scopes: api, write_repository
# Create at: GitLab → policyhub-service → Settings → Access Tokens
GITLAB_TOKEN=

# Maintainer PAT used only for MR merge during publishing (see setup guide Step 5).
GITLAB_MERGE_TOKEN=

# Numeric project ID of the policy-content repository.
# Find at: policy-content project overview page, or Settings → General.
GITLAB_PROJECT_ID=

# Shared secret for X-Gitlab-Token webhook verification.
# Must match GitLab → policy-content → Settings → Webhooks → Secret token.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITLAB_WEBHOOK_SECRET=

GITLAB_DEFAULT_BRANCH=main
GITLAB_CONTENT_PATH=policies
GITLAB_RATE_LIMIT_RPS=10


# ── Search — Typesense ────────────────────────────────────────────────────────
# Local defaults match docker-compose.yml.

TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# For local dev, matches TYPESENSE_API_KEY in docker-compose.yml.
TYPESENSE_API_KEY=local-dev-typesense-key


# ── AI — Anthropic ────────────────────────────────────────────────────────────
# AI features degrade gracefully if ANTHROPIC_API_KEY is absent:
#   Change summaries → manual text field fallback
#   Editor assistant → FAB hidden
#   Policy bot       → "unavailable" message shown
#   Embeddings       → not generated; bot search returns no results

ANTHROPIC_API_KEY=

# Do not change ANTHROPIC_MODEL without testing bot quality and reviewing costs.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Changing ANTHROPIC_EMBEDDING_MODEL requires re-embedding all policies:
#   node ace ai:embed-all
ANTHROPIC_EMBEDDING_MODEL=text-embedding-3-small

AI_BOT_RATE_LIMIT=20
AI_EDITOR_RATE_LIMIT=10


# ── Mail ──────────────────────────────────────────────────────────────────────

# One of: smtp, logger, memory
#   logger — prints to console (local dev default)
#   memory — captured in memory, not sent (set in .env.test, do not change here)
#   smtp   — sends real email (production)
MAIL_DRIVER=logger

MAIL_FROM=noreply@yourcompany.com

# Required when MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=


# ── File storage — Drive ──────────────────────────────────────────────────────
# Used for storing generated policy PDFs.

# One of: local, s3
DRIVE_DRIVER=local
DRIVE_LOCAL_ROOT=./storage

# Required when DRIVE_DRIVER=s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
